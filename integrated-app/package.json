{
  "name": "talkdeck-integrated-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "server": "node --import tsx server/index.ts",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "4.13.14",
    "lucide-react": "^1.65.0",
    "openai": "7.46.0",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
