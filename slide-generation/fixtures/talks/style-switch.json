    {
      "id": "style-switch-007",
      "startMs": 35289,
      "endMs": 44932,
      "kind": "utterance",
      "text": "Now change the whole deck to a dark navy background with light text and a warm amber accent. Keep the words, slide order, and frame labels unchanged.",
