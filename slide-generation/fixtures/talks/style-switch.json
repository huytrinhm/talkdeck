      "silenceAfterMs": 0
    },
    {
      "id": "style-switch-009",
      "startMs": 48147,
      "endMs": 54219,
      "kind": "utterance",
      "text": "Keep the new point in the new dark theme, even if an older styling operation finishes late.",
      "targetAlias": "practice",
      "silenceAfterMs": 0
    },
    {
      "id": "style-switch-010",
      "startMs": 54219,
      "endMs": 57077,
      "kind": "utterance",
      "text": "On Timebox, change 25 minutes to 30 minutes.",
      "targetAlias": "timebox",
      "silenceAfterMs": 0
    },
    {
      "id": "style-switch-011",
      "startMs": 57077,
      "endMs": 62077,
      "kind": "utterance",
      "text": "Change the running frame right label from Rehearsal to Workshop review across the deck.",
      "targetAlias": "deck",
      "silenceAfterMs": 0
    },
    {
      "id": "style-switch-012",
      "startMs": 62077,
      "endMs": 68149,
      "kind": "utterance",
      "text": "New slide titled Reflect. Use three points: Keep what worked. Name what failed. Choose the next step.",
      "targetAlias": "reflect",
      "silenceAfterMs": 0
    },
    {
      "id": "style-switch-013",
      "startMs": 68149,
      "endMs": 74935,
      "kind": "utterance",
      "text": "Make Prepare and Reflect use the same list design. Do not create a duplicate layout with the same slots.",
      "targetAlias": "deck",
      "silenceAfterMs": 0
    },
    {
      "id": "style-switch-014",
      "startMs": 74935,
      "endMs": 80293,
      "kind": "utterance",
      "text": "Return to Workshop plan. Make its title larger, preserving the new colors and all text.",
      "targetAlias": "opening",
      "silenceAfterMs": 0
    },
    {
      "id": "style-switch-015",
      "startMs": 80293,
      "endMs": 84579,
